# Copy to .env and replace the example database host and public origin.
READER_DB_HOST=mysql.example.internal
READER_DB_PORT=3306
READER_DB_NAME=reader
READER_DB_USER=reader
# true verifies MySQL certificates; false only for a trusted isolated network.
READER_DB_TLS_MODE=true
READER_PUBLIC_URL=https://reader.example.com
READER_COOKIE_SECURE=true
# Default: reachable only through a host reverse proxy.
READER_BIND_IP=127.0.0.1
READER_PORT=8081
# Password and setup token belong in secrets/*.txt, never in Git.
